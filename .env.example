# Copy this file to .env at the repository root. Never commit .env.
# Paste the PostgreSQL URL from your Supabase project's Connect dialog.
# Use the session pooler (port 5432) locally or transaction pooler (port 6543) on serverless hosts.
# URL-encode special characters in the database password.
DATABASE_URL=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the server-only legacy service_role JWT from Project Settings > API Keys.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=verisight-evidence
GEOFENCE_RADIUS_METERS=250
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set VITE_API_URL in the frontend deployment to the public FastAPI origin.
