# Copy this file to .env at the repository root for local development. Never commit .env.
# Backend/server-only. Add these in Vercel Project Settings > Environment Variables.
# Use the Supabase transaction pooler URL (port 6543) on Vercel.
# URL-encode special characters in the database password.
DATABASE_URL=
SUPABASE_URL=
# Use the server-only legacy service_role JWT from Supabase Project Settings > API Keys.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=verisight-evidence
GEOFENCE_RADIUS_METERS=250
# Comma-separated allowed cross-origin callers. Same-origin Vercel requests do not need CORS.
# Keep these local origins for the Vite dev server; append your Vercel site origin only if needed.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Frontend-visible build-time variable. Leave empty for the same-origin Vercel deployment.
# Never put secrets in VITE_ variables.
VITE_API_URL=
